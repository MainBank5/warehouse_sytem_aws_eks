# Terraform working dirs and state
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files (may hold secrets)
*.tfvars
*.tfvars.json
!example.tfvars

# Overrides and plan output
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan
tfplan

# Local data from Floci, if you mount ./data
data/